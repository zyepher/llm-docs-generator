{
  "id": "effect",
  "pack": {
    "title": "Effect",
    "description": "Typed effects, errors, and concurrency for TypeScript",
    "dependency": {
      "ecosystem": "npm",
      "name": "effect"
    },
    "sources": [
      {
        "type": "git",
        "repo": "https://github.com/Effect-TS/effect",
        "ref": "effect@{version}",
        "paths": [
          "MIGRATION.md",
          "migration",
          "packages/effect/README.md",
          "packages/ai/anthropic/CHANGELOG.md",
          "packages/effect/CHANGELOG.md",
          "packages/opentelemetry/CHANGELOG.md",
          "packages/vitest/CHANGELOG.md"
        ],
        "include": [
          "**/*.md"
        ]
      }
    ],
    "readFirst": [
      "pages/migration/v3-to-v4.md",
      "pages/MIGRATION.md",
      "pages/migration/cause.md"
    ]
  }
}
