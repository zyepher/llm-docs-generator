{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 3
    },
    "packsDir": {
      "type": "string",
      "minLength": 1
    },
    "agentFiles": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        }
      },
      "additionalProperties": false
    },
    "hook": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "nearCutoffDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "cutoff": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        }
      },
      "additionalProperties": false
    },
    "packs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "dependency": {
            "type": "object",
            "properties": {
              "ecosystem": {
                "type": "string",
                "enum": [
                  "npm",
                  "pypi",
                  "cargo",
                  "go",
                  "pub",
                  "swiftpm"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ecosystem",
              "name"
            ],
            "additionalProperties": false
          },
          "version": {
            "type": "string",
            "pattern": "^[^\\s<>\\p{Cc}]+$"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "git"
                    },
                    "repo": {
                      "type": "string"
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "paths": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "mount": {
                      "type": "string"
                    },
                    "include": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "exclude": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "passthrough": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "convert": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "tool": {
                              "type": "string",
                              "enum": [
                                "docling",
                                "markitdown",
                                "command",
                                "agent"
                              ]
                            },
                            "include": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "command": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "timeoutSeconds": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 3600
                            }
                          },
                          "required": [
                            "tool"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "transforms": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "strip-mintlify-banner",
                          "strip-html-comments",
                          "drop-frontmatter-description"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "repo",
                    "ref"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "urls"
                    },
                    "urls": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              },
                              "path": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "url",
                              "path"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "mount": {
                      "type": "string"
                    },
                    "include": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "exclude": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "passthrough": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "convert": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "tool": {
                              "type": "string",
                              "enum": [
                                "docling",
                                "markitdown",
                                "command",
                                "agent"
                              ]
                            },
                            "include": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "command": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "timeoutSeconds": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 3600
                            }
                          },
                          "required": [
                            "tool"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "transforms": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "strip-mintlify-banner",
                          "strip-html-comments",
                          "drop-frontmatter-description"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "urls"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "llms-txt"
                    },
                    "url": {
                      "type": "string"
                    },
                    "stripPrefix": {
                      "type": "string"
                    },
                    "mount": {
                      "type": "string"
                    },
                    "include": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "exclude": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "passthrough": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "convert": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "tool": {
                              "type": "string",
                              "enum": [
                                "docling",
                                "markitdown",
                                "command",
                                "agent"
                              ]
                            },
                            "include": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "command": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "timeoutSeconds": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 3600
                            }
                          },
                          "required": [
                            "tool"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "transforms": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "strip-mintlify-banner",
                          "strip-html-comments",
                          "drop-frontmatter-description"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "url",
                    "include"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "local"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mount": {
                      "type": "string"
                    },
                    "include": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "exclude": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "passthrough": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "convert": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "tool": {
                              "type": "string",
                              "enum": [
                                "docling",
                                "markitdown",
                                "command",
                                "agent"
                              ]
                            },
                            "include": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "command": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "timeoutSeconds": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 3600
                            }
                          },
                          "required": [
                            "tool"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "transforms": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "strip-mintlify-banner",
                          "strip-html-comments",
                          "drop-frontmatter-description"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "site": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string"
              },
              "aliases": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "baseUrl"
            ],
            "additionalProperties": false
          },
          "layout": {
            "type": "object",
            "properties": {
              "combined": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "license": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "limits": {
            "type": "object",
            "properties": {
              "maxFileBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 209715200
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "packs"
  ],
  "additionalProperties": false
}
