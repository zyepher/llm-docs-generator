{
  "name": "llm-docs",
  "version": "3.0.0",
  "description": "Version-pinned, verified reference docs for AI coding agents, kept in your repository and locked to your dependencies.",
  "type": "module",
  "keywords": [
    "llm",
    "ai-agents",
    "coding-agents",
    "documentation",
    "docs",
    "llms-txt",
    "agents-md",
    "claude-code",
    "cursor",
    "provenance",
    "lockfile",
    "markdown",
    "openapi"
  ],
  "author": "Zyepher",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "llm-docs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "data",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts src/index.ts --format esm --clean --minify --target node22 && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint ./src ./tests",
    "lint:fix": "biome lint --write ./src ./tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build && npm run test",
    "clean": "rm -rf dist",
    "schema": "tsx scripts/generate-schemas.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "js-yaml": "^5.5.0",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.1.3",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
