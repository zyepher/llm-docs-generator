{
  // Declarations only: tsdown bundles the JavaScript, and TypeScript 7 emits
  // the .d.ts files (it ships no compiler API for a bundler's dts step).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts"]
}
