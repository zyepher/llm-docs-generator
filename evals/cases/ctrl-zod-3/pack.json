{
  "id": "zod",
  "pack": {
    "title": "Zod",
    "description": "TypeScript-first schema validation",
    "dependency": {
      "ecosystem": "npm",
      "name": "zod"
    },
    "sources": [
      {
        "type": "git",
        "repo": "https://github.com/colinhacks/zod",
        "ref": "v{version}",
        "paths": [
          "README.md",
          "ERROR_HANDLING.md",
          "CHANGELOG.md",
          "MIGRATION.md"
        ],
        "include": [
          "**/*.md"
        ]
      }
    ],
    "readFirst": [
      "pages/MIGRATION.md",
      "pages/CHANGELOG.md"
    ]
  }
}
