{
  "id": "markdown-it",
  "pack": {
    "title": "markdown-it",
    "description": "Markdown parser with CommonMark support, extensions, and syntax plugins",
    "dependency": { "ecosystem": "npm", "name": "markdown-it" },
    "sources": [
      {
        "type": "git",
        "repo": "https://github.com/markdown-it/markdown-it",
        "ref": "{version}",
        "paths": ["README.md", "CHANGELOG.md", "docs"],
        "include": ["**/*.md"]
      }
    ]
  }
}
