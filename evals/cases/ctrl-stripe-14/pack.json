{
  "id": "stripe-node",
  "pack": {
    "title": "Stripe Node.js library",
    "description": "Official Stripe API client for Node.js",
    "dependency": { "ecosystem": "npm", "name": "stripe" },
    "sources": [
      {
        "type": "git",
        "repo": "https://github.com/stripe/stripe-node",
        "ref": "v{version}",
        "paths": ["README.md", "CHANGELOG.md"],
        "include": ["**/*.md"]
      }
    ]
  }
}
