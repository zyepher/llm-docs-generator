# Check out text files with LF on every platform (Windows runners default to
# CRLF), so Prettier's endOfLine check and byte-level fixtures behave the same.
* text=auto eol=lf
# cmd.exe misparses batch files with LF-only line endings.
*.cmd text eol=crlf
# Generated by npm run build:plugin; npm run check:plugin compares it byte for byte.
plugin/bin/llm-docs.mjs linguist-generated -diff
