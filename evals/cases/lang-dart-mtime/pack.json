{
  "id": "dart",
  "pack": {
    "title": "Dart",
    "description": "The Dart SDK changelog",
    "dependency": {
      "ecosystem": "toolchain",
      "name": "dart"
    },
    "sources": [
      {
        "type": "git",
        "repo": "https://github.com/dart-lang/sdk",
        "ref": "{version}.0",
        "paths": [
          "CHANGELOG.md"
        ]
      }
    ],
    "readFirst": [
      "pages/CHANGELOG.md"
    ]
  }
}
